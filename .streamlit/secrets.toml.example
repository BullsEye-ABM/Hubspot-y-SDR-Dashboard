# Copia este archivo a .streamlit/secrets.toml y rellena los valores reales.
# secrets.toml esta en .gitignore: nunca se sube a GitHub.
# En Streamlit Cloud, pega este mismo contenido (con los valores reales) en
# "Advanced settings" -> "Secrets" al desplegar la app.

[allo]
# API key de ALLO (Configuracion -> API / Integraciones en la plataforma ALLO).
api_key = "17195d9b-b6eb-4d85-badc-41aa9e3902c2"

[hubspot]
# Private App Token de HubSpot, solo usado por la pagina Ventas.
private_app_token = "pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# [auth] y [auth.google] -> ver utils/auth.py si se habilita el login con Google.
# [gcp_service_account] / sheet_id -> ver utils/sheets.py para la integracion con
# el Google Sheet de reuniones.
